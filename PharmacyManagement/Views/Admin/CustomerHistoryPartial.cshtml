@model PharmacyManagement.Models.ViewModels.Admin.CustomerPurchaseHistoryAdminViewModel

@if (Model != null && Model.Purchases != null && Model.Purchases.Any())
{
    <div class="accordion accordion-flush" id="purchaseHistoryAccordion">
        @foreach (var purchase in Model.Purchases)
        {
            <div class="accordion-item mb-3 border rounded-4 shadow-sm overflow-hidden">
                <h2 class="accordion-header" id="heading@(purchase.PurchaseId)">
                    <button class="accordion-button collapsed bg-white py-3" type="button" data-bs-toggle="collapse" data-bs-target="#collapse@(purchase.PurchaseId)" aria-expanded="false" aria-controls="collapse@(purchase.PurchaseId)">
                        <div class="d-flex w-100 justify-content-between align-items-center flex-wrap gap-2 me-3">
                            <div>
                                <span class="badge bg-primary rounded-pill me-2 px-3 py-2">Order #@purchase.PurchaseId</span>
                                <span class="text-muted small">
                                    <i class="far fa-calendar-alt me-1"></i>@purchase.PurchaseDate.ToString("MMM dd, yyyy - hh:mm tt")
                                </span>
                            </div>
                            <div>
                                <span class="fw-bold text-success">Total: BDT @purchase.TotalAmount.ToString("0.00")</span>
                            </div>
                        </div>
                    </button>
                </h2>
                <div id="collapse@(purchase.PurchaseId)" class="accordion-collapse collapse" aria-labelledby="heading@(purchase.PurchaseId)" data-bs-parent="#purchaseHistoryAccordion">
                    <div class="accordion-body bg-light p-3">
                        <div class="table-responsive">
                            <table class="table table-sm table-hover table-bordered bg-white align-middle mb-0 rounded-3 overflow-hidden">
                                <thead class="table-light text-uppercase text-muted" style="font-size: 11px;">
                                    <tr>
                                        <th class="py-2 px-3">Medicine Name</th>
                                        <th class="py-2 px-3 text-center">Qty</th>
                                        <th class="py-2 px-3 text-end">Unit Price</th>
                                        <th class="py-2 px-3 text-end">Subtotal</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in purchase.PurchaseItems)
                                    {
                                        <tr>
                                            <td class="fw-semibold text-dark px-3">@item.MedicineName</td>
                                            <td class="text-center px-3">@item.Quantity</td>
                                            <td class="text-end px-3 text-muted">BDT @item.UnitPrice.ToString("0.00")</td>
                                            <td class="text-end px-3 fw-bold text-dark">BDT @item.TotalPrice.ToString("0.00")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="text-center py-5">
        <i class="fas fa-shopping-bag fa-3x text-muted mb-3 opacity-50"></i>
        <h6 class="fw-bold text-secondary">No Purchase History</h6>
        <p class="text-muted small mb-0">This customer hasn't placed any orders yet.</p>
    </div>
}