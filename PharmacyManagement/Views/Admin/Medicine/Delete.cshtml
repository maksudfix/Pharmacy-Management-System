@model PharmacyManagement.Models.Medicine

@{
    ViewData["Title"] = "Delete Medicine";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Delete Medicine</h1>
    <h3>Are you sure you want to delete this?</h3>
    <div>
        <h4>@Model.Name</h4>
        <dl class="row">
            <dt class="col-sm-2">Generic Name</dt>
            <dd class="col-sm-10">@Model.GenericName</dd>
        </dl>

        <form asp-action="DeleteMedicine">
            <input type="hidden" asp-for="MedicineId" />
            <input type="submit" value="Delete" class="btn btn-danger" /> |
            <a asp-action="Medicines" class="btn btn-secondary">Back to List</a>
        </form>
    </div>
</div>