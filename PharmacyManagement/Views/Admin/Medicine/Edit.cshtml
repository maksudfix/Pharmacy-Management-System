@model PharmacyManagement.Models.ViewModels.Medicine.MedicineEditViewModel

@{
    ViewData["Title"] = "Edit Medicine";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Edit Medicine</h1>
    <div class="card mb-4">
        <div class="card-body">
            <form asp-action="Edit" enctype="multipart/form-data">
                <input type="hidden" asp-for="MedicineId" />
                <input type="hidden" asp-for="ImageUrl" />
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CategoryId" class="form-label">Category</label>
                    <select asp-for="CategoryId" asp-items="Model.Categories" class="form-control"></select>
                </div>

                <div class="mb-3">
                    <label asp-for="ImageFile" class="form-label"></label>
                    <input asp-for="ImageFile" type="file" class="form-control" />
                </div>

                <button type="submit" class="btn btn-primary">Update</button>
                <a asp-action="Medicines" class="btn btn-secondary">Back to List</a>
            </form>
        </div>
    </div>
</div>