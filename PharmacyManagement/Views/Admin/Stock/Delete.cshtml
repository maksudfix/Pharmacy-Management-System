@model PharmacyManagement.Models.Stock

@{
    ViewData["Title"] = "Delete Stock";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Delete Stock</h1>
    <h3>Are you sure you want to delete this stock entry?</h3>
    <div>
        <dl class="row">
            <dt class="col-sm-2">Batch Number</dt>
            <dd class="col-sm-10">@Model.BatchNumber</dd>
            <dt class="col-sm-2">Quantity</dt>
            <dd class="col-sm-10">@Model.Quantity</dd>
        </dl>

        <form asp-action="DeleteStock">
            <input type="hidden" asp-for="StockId" />
            <input type="submit" value="Delete" class="btn btn-danger" /> |
            <a asp-action="Stocks" class="btn btn-secondary">Back to List</a>
        </form>
    </div>
</div>