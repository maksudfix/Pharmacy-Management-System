@model IEnumerable<PharmacyManagement.Models.ViewModels.Stock.StockViewModel>

@{
    ViewData["Title"] = "Manage Stocks";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Stocks</h1>
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div><i class="fas fa-table me-1"></i> Stock Inventory</div>
            <a asp-action="AddStock" class="btn btn-primary btn-sm">Add Stock</a>
        </div>
        <div class="card-body">
            <table class="table table-bordered table-striped">
                <thead>
                    <tr>
                        <th>Batch</th>
                        <th>Medicine</th>
                        <th>Quantity</th>
                        <th>Purchase Price</th>
                        <th>Selling Price</th>
                        <th>Expiry Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.BatchNumber</td>
                            <td>@item.MedicineName</td>
                            <td>@item.Quantity</td>
                            <td>BDT @item.PurchasePrice.ToString("0.00")</td>
                            <td>BDT @item.SellingPrice.ToString("0.00")</td>
                            <td>@item.ExpiryDate.ToShortDateString()</td>
                            <td>
                                <a asp-action="EditStock" asp-route-id="@item.StockId" class="btn btn-warning btn-sm">Edit</a>
                                <a asp-action="DeleteStock" asp-route-id="@item.StockId" class="btn btn-danger btn-sm">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>