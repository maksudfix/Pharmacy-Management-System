@model PharmacyManagement.Models.ViewModels.Customer.CustomerLoginViewModel

@{
    ViewData["Title"] = "Customer Login";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow border-0 rounded-4">
            <div class="card-body p-5">
                <div class="text-center mb-4">
                    <h2 class="fw-bold text-primary">Pharmacy Portal</h2>
                    <p class="text-muted">Sign In</p>
                </div>

                <form asp-controller="Auth" asp-action="Login" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="form-floating mb-3">
                        <input asp-for="Email" class="form-control" autocomplete="username" aria-required="true" />
                        <label asp-for="Email">Email Address</label>
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Password" class="form-control" autocomplete="current-password" aria-required="true" />
                        <label asp-for="Password">Password</label>
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <!-- Centered Slim Pill Button -->
                    <div class="d-grid gap-2 d-md-flex justify-content-center mb-3">
                        <button type="submit" class="btn btn-primary rounded-pill px-4 py-2 shadow-sm">Log In</button>
                    </div>

                    <div class="text-center">
                        <p class="text-muted">Don't have an account? <a asp-controller="Auth" asp-action="Register" class="text-decoration-none fw-bold">Register here</a></p>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}