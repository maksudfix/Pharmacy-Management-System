@model PharmacyManagement.Models.ViewModels.Cart.CheckoutViewModel

@{
    ViewData["Title"] = "Checkout";
}

<div class="container my-4">
    <h2>Checkout</h2>
    <hr />

    <form asp-action="ProcessCheckout" method="post" id="checkoutForm">
        @Html.AntiForgeryToken()
        
        <input type="hidden" asp-for="CustomerId" />

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row">
            <!-- Left Column: Cart Items & Details -->
            <div class="col-md-8">
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-primary text-white">
                        <h4 class="mb-0">Order Items</h4>
                    </div>
                    <div class="card-body">
                        @if (Model.CartItems != null && Model.CartItems.Any())
                        {
                            <div class="table-responsive">
                                <table class="table align-middle">
                                    <thead>
                                        <tr>
                                            <th>Medicine</th>
                                            <th>Unit Price</th>
                                            <th style="width: 150px;">Quantity</th>
                                            <th class="text-end">Total</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @for (int i = 0; i < Model.CartItems.Count; i++)
                                        {
                                            <input type="hidden" asp-for="CartItems[i].MedicineId" />
                                            <input type="hidden" asp-for="CartItems[i].MedicineName" />
                                            <input type="hidden" asp-for="CartItems[i].UnitPrice" />
                                            <input type="hidden" asp-for="CartItems[i].StockLimit" />

                                            <tr>
                                                <td>
                                                    <strong>@Model.CartItems[i].MedicineName</strong>
                                                    <br />
                                                    <small class="text-muted">Available Stock: @Model.CartItems[i].StockLimit</small>
                                                </td>
                                                <td>BDT @Model.CartItems[i].UnitPrice.ToString("0.00")</td>
                                                <td>
                                                    <input type="number" 
                                                           asp-for="CartItems[i].Quantity" 
                                                           class="form-control quantity-input" 
                                                           min="1" 
                                                           max="@Model.CartItems[i].StockLimit" 
                                                           data-unit-price="@Model.CartItems[i].UnitPrice" />
                                                    <span asp-validation-for="CartItems[i].Quantity" class="text-danger"></span>
                                                </td>
                                                <td class="text-end fw-bold item-total">
                                                    $@((Model.CartItems[i].UnitPrice * Model.CartItems[i].Quantity).ToString("0.00"))
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted">Your cart is empty.</p>
                        }
                    </div>
                </div>

                <!-- Prescription Selection (Optional) -->
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-secondary text-white">
                        <h5 class="mb-0">Attach Prescription (Optional)</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label asp-for="PrescriptionId" class="form-label">Select Uploaded Prescription</label>
                            <select asp-for="PrescriptionId" asp-items="Model.Prescriptions" class="form-select">
                                <option value="">-- None --</option>
                            </select>
                            <span asp-validation-for="PrescriptionId" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column: Shipping & Summary -->
            <div class="col-md-4">
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-success text-white">
                        <h4 class="mb-0">Payment & Delivery</h4>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label asp-for="PaymentMethod" class="form-label">Payment Method</label>
                            <select asp-for="PaymentMethod" class="form-select">
                                <option value="CashOnDelivery">Cash on Delivery</option>
                                <option value="CreditCard">Credit Card</option>
                                <option value="OnlineBanking">Online Banking</option>
                            </select>
                            <span asp-validation-for="PaymentMethod" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="DeliveryMethod" class="form-label">Delivery Method</label>
                            <select asp-for="DeliveryMethod" id="DeliveryMethod" class="form-select">
                                <option value="HomeDelivery">Home Delivery</option>
                                <option value="StorePickup">Store Pickup</option>
                            </select>
                            <span asp-validation-for="DeliveryMethod" class="text-danger"></span>
                        </div>

                        <div class="mb-3" id="addressContainer">
                            <label asp-for="DeliveryAddress" class="form-label">Delivery Address</label>
                            <textarea asp-for="DeliveryAddress" class="form-control" rows="3" placeholder="Enter full delivery address..."></textarea>
                            <span asp-validation-for="DeliveryAddress" class="text-danger"></span>
                        </div>

                        <hr />

                        <div class="d-flex justify-content-between mb-3">
                            <h5 class="fw-bold">Grand Total:</h5>
                            <h5 class="fw-bold text-success" id="grandTotal">BDT 0.00</h5>
                        </div>

                        <button type="submit" class="btn btn-success w-100 py-2">Place Order</button>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const quantityInputs = document.querySelectorAll(".quantity-input");
            const grandTotalElement = document.getElementById("grandTotal");
            const deliveryMethodSelect = document.getElementById("DeliveryMethod");
            const addressContainer = document.getElementById("addressContainer");

            // Function to recalculate totals
            function updateTotals() {
                let grandTotal = 0;

                quantityInputs.forEach(input => {
                    const unitPrice = parseFloat(input.getAttribute("data-unit-price")) || 0;
                    let quantity = parseInt(input.value) || 0;
                    const maxStock = parseInt(input.getAttribute("max")) || 0;

                    // Enforce stock boundaries client-side
                    if (quantity > maxStock) {
                        quantity = maxStock;
                        input.value = maxStock;
                    }
                    if (quantity < 1) {
                        quantity = 1;
                        input.value = 1;
                    }

                    const itemTotal = unitPrice * quantity;
                    
                    // Update individual row total
                    const row = input.closest("tr");
                    const itemTotalCell = row.querySelector(".item-total");
                    itemTotalCell.textContent = "BDT" + itemTotal.toFixed(2);

                    grandTotal += itemTotal;
                });

                // Update Grand Total
                grandTotalElement.textContent = "BDT" + grandTotal.toFixed(2);
            }

            // Function to toggle address field visibility based on delivery method
            function toggleAddressVisibility() {
                if (deliveryMethodSelect.value === "StorePickup") {
                    addressContainer.style.display = "none";
                } else {
                    addressContainer.style.display = "block";
                }
            }

            // Attach event listeners to quantity inputs
            quantityInputs.forEach(input => {
                input.addEventListener("input", updateTotals);
                input.addEventListener("change", updateTotals);
            });

            // Attach event listener for delivery method toggle
            if (deliveryMethodSelect) {
                deliveryMethodSelect.addEventListener("change", toggleAddressVisibility);
            }

            // Initial calculations on page load
            updateTotals();
            toggleAddressVisibility();
        });
    </script>
}