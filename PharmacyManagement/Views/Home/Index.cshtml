@model IEnumerable<PharmacyManagement.Models.ViewModels.Medicine.MedicineViewModel>

@{
    ViewData["Title"] = "Home";
    var categories = ViewBag.Categories as List<PharmacyManagement.Models.Category>;
}

<!-- Modern Clean Hero Section -->
<div class="p-4 mb-4 bg-gradient bg-white border border-light rounded-4 shadow-sm text-center">
    <div class="container-fluid py-2">
        <h1 class="fw-bold text-dark mb-3">Quality Medicines, Delivered Fast</h1>

        <!-- Search & Filter Bar -->
        <form asp-controller="Home" asp-action="Index" method="get" class="row g-2 justify-content-center mt-2">
            <div class="col-md-4">
                <input type="text" name="searchString" value="@ViewBag.SearchString" class="form-control rounded-pill px-3 bg-light border-0" placeholder="Search medicine..." />
            </div>
            <div class="col-md-3">
                <select name="categoryId" class="form-select rounded-pill px-3 bg-light border-0">
                    <option value="">All Categories</option>
                    @if (categories != null)
                    {
                        foreach (var cat in categories)
                        {
                            if (ViewBag.SelectedCategory != null && (int)ViewBag.SelectedCategory == cat.CategoryId)
                            {
                                <option value="@cat.CategoryId" selected="selected">@cat.Name</option>
                            }
                            else
                            {
                                <option value="@cat.CategoryId">@cat.Name</option>
                            }
                        }
                    }
                </select>
            </div>
            <div class="col-md-auto">
                <button type="submit" class="btn btn-success px-4 rounded-pill shadow-sm">Filter</button>
            </div>
        </form>
    </div>
</div>

<!-- Medicine Grid -->
<div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">
    @if (Model != null)
    {
        foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0 rounded-4 p-3 bg-white hover-shadow transition">
                    <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/images/default-medicine.png" : item.ImageUrl)" class="card-img-top rounded-4 bg-light p-3" style="height: 180px; object-fit: contain;" alt="@item.Name">
                    <div class="card-body d-flex flex-column px-0 pb-0">
                        <span class="badge bg-success bg-opacity-10 text-success mb-2 align-self-start rounded-pill px-3 py-1 fw-semibold small">@item.CategoryName</span>
                        <h5 class="card-title fw-bold text-dark">@item.Name</h5>
                        <p class="card-text text-muted small mb-1">Generic: @item.GenericName</p>
                        <p class="card-text text-muted small mb-3">Form: @item.DosageForm (@item.Strength)</p>

                        <div class="mt-auto pt-3 border-top border-light">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div>
                                    <span class="d-block text-muted small" style="font-size: 11px;">Price</span>
                                    <span class="fs-5 fw-bold text-dark">BDT @item.LatestSellingPrice.ToString("0.00")</span>
                                </div>
                                <div class="text-end">
                                    <span class="d-block text-muted small" style="font-size: 11px;">Stock</span>
                                    @if (item.TotalStockQuantity > 0)
                                    {
                                        <span class="fw-semibold text-secondary small">@item.TotalStockQuantity left</span>
                                    }
                                    else
                                    {
                                        <span class="fw-bold text-danger small">Out of Stock</span>
                                    }
                                </div>
                            </div>

                            @* Hide the Buy Now option if the user is in the "Admin" role or if item is out of stock *@
                            @if (!User.IsInRole("Admin"))
                            {
                                @if (item.TotalStockQuantity > 0)
                                {
                                    <a asp-controller="Customer" asp-action="Checkout" asp-route-medicineId="@item.MedicineId" asp-route-quantity="1" class="btn btn-success w-100 rounded-pill fw-medium shadow-sm">Buy Now</a>
                                }
                                else
                                {
                                    <button class="btn btn-secondary w-100 rounded-pill fw-medium shadow-sm" disabled>Unavailable</button>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}